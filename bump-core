#!/usr/bin/env python3

"""Rewrite the notebook-language-server-core pin in every proxy's stack file(s).

A core bump touches ten stack files: one each in rust, cpp and go, and seven in hnls. Run this
from the core checkout; the proxies are expected to be siblings of it.
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

REPOS = [
    "rust-notebook-language-server",
    "cpp-notebook-language-server",
    "go-notebook-language-server",
    "haskell-notebook-language-server",
]

PIN = re.compile(
    r"^(- git: https://github\.com/codedownio/notebook-language-server-core\.git\n\s*commit: )([0-9a-f]{40})$",
    re.M,
)


def stack_files(repo):
    return sorted(p for p in [repo / "stack.yaml", *(repo / "stack").glob("*.yaml")] if p.is_file())


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("commit", nargs="?", help="core commit to pin (default: this checkout's HEAD)")
    parser.add_argument("--root", type=Path, help="directory holding the proxy checkouts (default: core's parent)")
    args = parser.parse_args()

    core = Path(__file__).resolve().parent
    commit = args.commit or subprocess.run(
        ["git", "-C", str(core), "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    root = args.root or core.parent

    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        sys.exit(f"not a full commit sha: {commit}")

    changed = 0
    for name in REPOS:
        repo = root / name
        if not repo.is_dir():
            print(f"{name}: not at {repo}, skipping")
            continue
        for f in stack_files(repo):
            text = f.read_text()
            new, n = PIN.subn(lambda m: m.group(1) + commit, text)
            if n and new != text:
                f.write_text(new)
                print(f"{f.relative_to(root)}: pinned {commit[:12]}")
                changed += 1
            elif n:
                print(f"{f.relative_to(root)}: already at {commit[:12]}")

    if changed:
        print(f"\n{changed} file(s) rewritten. Build each repo to refresh its stack.yaml.lock.")


if __name__ == "__main__":
    main()
